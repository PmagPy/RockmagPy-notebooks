{"version":3,"kind":"Notebook","sha256":"ac0cce057fbae609b2b54a86c99df3952aa0ae0c1d0a3923e2d17ab840dfd2c2","slug":"mpms-signal-blender","location":"/MPMS_notebooks/MPMS_signal_blender.ipynb","dependencies":[],"frontmatter":{"title":"Simulate MPMS data with a mixture of standard mineral phases in the rock magnetism bestiary","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"base","language":"python"},"authors":[{"nameParsed":{"literal":"RockmagPy Contributors","given":"RockmagPy","family":"Contributors"},"name":"RockmagPy Contributors","id":"contributors-myst-generated-uid-0"}],"github":"https://github.com/PmagPy/RockmagPy-notebooks","copyright":"2025","numbering":{"title":{"offset":1}},"source_url":"https://github.com/PmagPy/RockmagPy-notebooks/blob/main/MPMS_notebooks/MPMS_signal_blender.ipynb","edit_url":"https://github.com/PmagPy/RockmagPy-notebooks/edit/main/MPMS_notebooks/MPMS_signal_blender.ipynb","exports":[{"format":"ipynb","filename":"MPMS_signal_blender.ipynb","url":"/RockmagPy-notebooks/build/MPMS_signal_blender-b6ee6e6125a8567d5c7e30529ed721cb.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Low-temperature magnetic remanence experiments are useful tools for qualitatively assessing existing magnetic mineral phases and their characteristics in rock samples. However, it is almost always the case where a rock sample contains an assemblage of magnetic grains. This notebook presents a simple mixture function that can be used to simulate toy models of MPMS data with data from charaterized mineral standards developed at the IRM. The linear mixtures assume no interaction between the magnetic phases. The resultant ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"KcRNrsMvDY"},{"type":"strong","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"mass-normalized","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"vPCQF2nAED"}],"key":"DqBI7nkqxP"},{"type":"text","value":" remanence curves may serve as a useful tool for developing intuition about what mineral phases may dominate the remanence behavior with various mixing proportions.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"E2z8LkwTe5"}],"key":"OrUqalcKZJ"}],"key":"RSiLHxvVdD"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import pmagpy.rockmag as rmag\nimport pmagpy.contribution_builder as cb\nimport pmagpy.ipmag as ipmag\n\nfrom scipy.interpolate import interp1d\nfrom ipywidgets import interact, widgets, FloatSlider\nfrom IPython.display import display","key":"o1jPyFYe7n"},{"type":"outputs","id":"4-XQhN7fKbEJIYm-hhpQt","children":[],"key":"dTeDqw4qOZ"}],"key":"iovc0SdXoF"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"load rock magnetism bestiary data from the MagIC database","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"FbsRtDxXMS"}],"identifier":"load-rock-magnetism-bestiary-data-from-the-magic-database","label":"load rock magnetism bestiary data from the MagIC database","html_id":"load-rock-magnetism-bestiary-data-from-the-magic-database","implicit":true,"key":"ZMAHAV6fQn"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The Rock Magnetic Bestiary (RMB) is a curated collection of rock magnetic data developed at the Institute for Rock Magnetism (IRM) focused on well-characterized synthetic and natural materials. Inspired by medieval bestiaries that cataloged natural entities through allegorical descript